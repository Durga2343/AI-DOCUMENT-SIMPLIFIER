# Server Environment Variables
# In production on Render, configure these under Service -> Environment:

# Port (Render assigns PORT automatically, fallback for local dev is 5005)
PORT=5005

# MongoDB Atlas connection string (e.g., mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/document-simplifier?retryWrites=true&w=majority

# JWT secret key for signing auth tokens
JWT_SECRET=supersecretjwtkey_12345!@#$%

# Google Gemini API Key for document analysis
GEMINI_API_KEY=your_gemini_api_key_here
